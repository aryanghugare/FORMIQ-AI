{
  "name": "formiq-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "app:start": "node scripts/start-docker.mjs",
    "docker:start": "node scripts/start-docker.mjs",
    "docker:stop": "docker compose -f compose.local.yaml down",
    "docker:logs": "docker compose -f compose.local.yaml logs --tail=100 -f",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:check": "node scripts/check-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:mongo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-mongo.mjs",
    "workspace:manage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/manage.mjs"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "mongodb": "6.20.0",
    "next": "16.2.7",
    "nodemailer": "10.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "https://registry.npmjs.org/@playwright/test/-/test-1.62.0.tgz",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.27.4",
    "@mongodb-js/saslprep": "1.5.2"
  }
}

# Node.js >=22.13, local disk or persistent mounted volume required.
FORMIQ_DATA_DIR=.formiq
# Demo data/login enabled outside production only. Set true explicitly for a production demo.
FORMIQ_DEMO=true
# Required when FORMIQ_DEMO=false. Creates the first local workspace account.
FORMIQ_ADMIN_EMAIL=
FORMIQ_ADMIN_PASSWORD=
# Optional ODA File Converter executable, no shell command or arguments.
# macOS example: /Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter
ODA_CONVERTER_PATH=
# Optional alternative executable implementing: converter input.dwg output.dxf
DWG_CONVERTER_PATH=
# Set true when serving over HTTPS (production default).
FORMIQ_SECURE_COOKIES=false

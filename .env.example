# Set MONGODB_URI for MongoDB + GridFS storage (no persistent Render disk needed).
# Keep credentials server-side; never use a NEXT_PUBLIC_ variable for this URI.
MONGODB_URI=
MONGODB_DB=formiq
# Optional public application origin, e.g. https://your-app.onrender.com.
# Render's RENDER_EXTERNAL_URL is detected automatically when this is unset.
FORMIQ_APP_URL=
# Without MONGODB_URI, the existing SQLite/local demo mode is used.
# Node.js >=22.13, local disk or persistent mounted volume required.
FORMIQ_DATA_DIR=.formiq
# Demo data/login enabled outside production only. Set true explicitly for a production demo.
FORMIQ_DEMO=true
# Required when FORMIQ_DEMO=true in production (12-200 characters). Never displayed on the login page.
FORMIQ_DEMO_PASSWORD=
# Time zone for dates in the workspace (IANA name). Default: Asia/Kolkata.
FORMIQ_TIME_ZONE=
# Per-address login and sign-up limits need a client address you can trust. Set one of these:
# a header your edge proxy always overwrites (for example true-client-ip behind Cloudflare), or
# the number of your own proxies appending to X-Forwarded-For. Unset: login is limited per account only,
# so repeated bad attempts can lock that account for 15 minutes.
FORMIQ_CLIENT_IP_HEADER=
FORMIQ_TRUSTED_PROXY_HOPS=
# Optional first account for MongoDB; required for private SQLite mode.
FORMIQ_ADMIN_EMAIL=
FORMIQ_ADMIN_PASSWORD=
# Optional ODA File Converter executable, no shell command or arguments.
# macOS example: /Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter
ODA_CONVERTER_PATH=
# Optional alternative executable implementing: converter input.dwg output.dxf
DWG_CONVERTER_PATH=
# Optional LibreDWG dwg2dxf executable. Auto-detected in Docker and Homebrew.
LIBREDWG_CONVERTER_PATH=
# Set true when serving over HTTPS (production default).
FORMIQ_SECURE_COOKIES=false
